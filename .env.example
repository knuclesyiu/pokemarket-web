# PokeMarket — example environment variables
# Copy this to `.env` and fill in real values.
# Do NOT commit `.env` — see .gitignore.

# ─── Firebase Web SDK (used by src/services/firebase.ts) ─────────────────────
EXPO_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
EXPO_PUBLIC_FIREBASE_PROJECT_ID=pokemarket-255c6
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=pokemarket-255c6.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
EXPO_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:abcdef

# ─── Stripe (Publishable key only — server uses secret key in Cloud Functions) ─
# Get from https://dashboard.stripe.com/apikeys
# Use pk_test_* during development, pk_live_* only after launch.
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx

# ─── Fee tuning (optional — defaults in src/config/platform.ts) ───────────────
# EXPO_PUBLIC_PLATFORM_FEE_PERCENT=0.03
# EXPO_PUBLIC_ORDER_MIN_FEE_HKD=20
