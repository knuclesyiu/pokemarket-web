{
  "name": "pokemarket-functions",
  "version": "1.0.0",
  "description": "PokeMarket Cloud Functions — escrow, listings, search, verification",
  "private": true,
  "engines": {
    "node": "20"
  },
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "lint": "echo 'no linter configured'"
  },
  "engines": {
    "node": "20"
  },
  "dependencies": {
    "firebase-admin": "^12.0.0",
    "firebase-functions": "^5.0.0",
    "stripe": "^17.0.0"
  },
  "devDependencies": {
    "typescript": "^5.4.0"
  },
  "private": true
}
