# PokeMarket — Cloud Functions environment (example)
#
# Copy this to `functions/.env` for local emulator runs. The file is
# gitignored and must never be committed.
#
# For the deployed project, set these as Firebase secrets instead:
#
#   firebase functions:secrets:set STRIPE_SECRET_KEY
#   firebase functions:secrets:set STRIPE_WEBHOOK_SECRET
#
# `scripts/setup_stripe_secrets.sh` does both from a local file.

# ─── Stripe ───────────────────────────────────────────────────────────────────
# The secret key. Create one at https://dashboard.stripe.com/apikeys.
# Use sk_test_* while developing, sk_live_* only after launch.
#
# This is the platform's own key — it is NOT the seller's. Sellers get
# a Stripe Connect Express account created by createSellerAccount, and
# the platform moves their money with a destination charge.
STRIPE_SECRET_KEY=sk_test_...

# ─── Stripe webhook ───────────────────────────────────────────────────────────
# The signing secret for the webhook endpoint. Create the endpoint at
# https://dashboard.stripe.com/webhooks with this URL:
#
#   https://us-central1-pokemarket-255c6.cloudfunctions.net/stripeWebhook
#
# Subscribe it to: payment_intent.succeeded, payment_intent.payment_failed,
# charge.refunded, payout.paid, payout.failed, transfer.created.
#
# Copy the "signing secret" (whsec_...) from the endpoint's page.
STRIPE_WEBHOOK_SECRET=whsec_...
