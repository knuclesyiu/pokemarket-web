rules_version = '2';

// Firestore Security Rules for PokeMarket
//
// DEPLOY: Paste this into Firebase Console → Firestore → Rules tab → Publish.
// OR: firebase deploy --only firestore:rules
//
// These rules enforce:
//   1. Auth: only signed-in users can read most data
//   2. Ownership: users can only write to their own profile/portfolio/wallet
//   3. Card catalog: public read, server-only write
//   4. Orders: only buyer + seller can read; only buyer can create
//   5. Listings: public read; only owner can create/update/delete
//   6. Chat: only thread participants can read/write
//
// IMPORTANT: This is a permissive MVP. Pre-launch hardening you should add:
//   - require email_verified == true for createListing / createOrder
//     (not enforced yet — see the note by the helpers below)
//   - rate-limit writes (currently per-user; consider per-IP at the App Check layer)
//   - Cloud Function validation hooks via request.auth.token.admin

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helpers ───────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Email verification is deliberately NOT enforced yet: the
    // registration flow creates the account and lands the user in the
    // app, and requiring a verified address before that happens blocks
    // people who never open the verification email.
    //
    // Before launch, add this helper back and require it on the
    // writes that move money:
    //
    //   function isEmailVerified() {
    //     return isSignedIn() && request.auth.token.email_verified == true;
    //   }
    //
    // then append `&& isEmailVerified()` to the `create` rules for
    // /orders and /listings. The functions that write those documents
    // use the Admin SDK and bypass these rules, so the check has to
    // live in the Cloud Function too.

    // ─── Public card catalog ──────────────────────────────────────────
    // Anyone can read card_prices (public market data). Only the
    // backend (Cloud Functions / Admin SDK) writes — clients cannot.
    match /card_prices/{cardId} {
      allow read: if true;
      allow write: if false;
    }

    // ─── Card image CDN cache (optional optimization) ────────────────
    match /card_image_cache/{cardId} {
      allow read: if true;
      allow write: if false;
    }

    // ─── User profiles ────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(userId);
      allow delete: if false;

      // Wallet balance subcollection
      match /wallet/{document=**} {
        allow read: if isOwner(userId);
        // Backend-only writes (Stripe webhooks)
        allow write: if false;
      }

      // Portfolio subcollection
      match /portfolio/{cardId} {
        allow read, write: if isOwner(userId);
      }

      // Transaction history (escrow records)
      match /transactions/{txId} {
        allow read: if isOwner(userId);
        allow write: if false; // backend-only
      }

      // PIN attempt counter (used for server-side rate limiting)
      match /pinAttempts/{document=**} {
        allow read, write: if false; // backend-only
      }
    }

    // ─── Market listings (sell side) ────────────────────────────────
    match /listings/{listingId} {
      // Public catalog of active listings
      allow read: if true;

      // SECURITY: all listing writes go through the createListing Cloud
      // Function (Admin SDK bypasses these rules), which validates the
      // card, price and seller identity. Denying client writes here stops
      // a seller from self-marking a listing 'sold' or from injecting
      // arbitrary fields into a public document.
      allow create, update, delete: if false;
    }

    // ─── Orders (escrow flow) ────────────────────────────────────────
    match /orders/{orderId} {
      // Only buyer and seller can read
      allow read: if isSignedIn() && (
        resource.data.buyerId == request.auth.uid ||
        resource.data.sellerId == request.auth.uid
      );

      // Buyer creates the order (validated server-side by Cloud Function
      // before the order is actually created — the client just calls
      // createPaymentIntent which writes the order).
      allow create: if isSignedIn()
        && request.resource.data.buyerId == request.auth.uid
        && request.resource.data.amountHkd is number
        && request.resource.data.amountHkd > 0
        && request.resource.data.cardId is string
        && request.resource.data.sellerId is string
        && request.resource.data.sellerId != request.auth.uid;

      // Updates are server-only (Stripe webhook → Cloud Function updates
      // status). Clients can NEVER modify order state.
      allow update, delete: if false;
    }

    // ─── Offers (trade flow) ─────────────────────────────────────────
    //
    // SECURITY: clients must NOT be able to write offer status. Every
    // status transition (accept / reject / counter / cancel) goes through
    // a Cloud Function, which uses the Admin SDK and bypasses these rules.
    // Previously the buyer could update their own offer and set
    // status='accepted' themselves — which would let them take the
    // seller's card without the seller ever agreeing.
    match /offers/{offerId} {
      // Only buyer and seller can read
      allow read: if isSignedIn() && (
        resource.data.buyerId == request.auth.uid ||
        resource.data.sellerId == request.auth.uid
      );

      // Buyer creates the offer (validated server-side by createOffer)
      allow create: if isSignedIn()
        && request.resource.data.buyerId == request.auth.uid
        && request.resource.data.sellerId != request.auth.uid
        && request.resource.data.listingId is string;

      // Client-side updates are NOT allowed for status. createOffer /
      // respondToOffer / cancelOffer (Cloud Functions) handle this.
      allow update: if false;
      allow delete: if false; // soft-delete via status field
    }

    // ─── Chat threads ────────────────────────────────────────────────
    //
    // The participant list is stored in the `parties` field (this is the
    // name the app's ChatThread type and both chat screens use).
    match /chat_threads/{threadId} {
      // Only thread participants can read the thread metadata
      allow read: if isSignedIn()
        && request.auth.uid in resource.data.parties;

      // Create only if you're one of the participants
      allow create: if isSignedIn()
        && request.auth.uid in request.resource.data.parties
        && request.resource.data.parties.size() == 2;

      // Update thread metadata (lastMessage, unreadCount) — only by a
      // participant.
      //
      // The second condition prevents participants from removing each
      // other from the thread: the participant list must be unchanged.
      // NOTE: it must compare request.resource against resource —
      // `request.auth.data.parties` (the previous code) does not exist on
      // the auth token, so the comparison was always false and EVERY
      // thread update was silently denied.
      allow update: if isSignedIn()
        && request.auth.uid in resource.data.parties
        && request.resource.data.parties == resource.data.parties;

      // Messages subcollection
      match /messages/{messageId} {
        // Only thread participants can read messages
        allow read: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/chat_threads/$(threadId)).data.parties;

        // Only the sender can create a message with their own uid
        allow create: if isSignedIn()
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 4000;

        // Sender can mark their own message as deleted (soft delete).
        // The diff must compare request.resource against resource — using
        // `resource.data.diff(resource.data)` yields an empty set, which
        // makes the hasOnly() check vacuously true and lets the sender
        // overwrite ANY field of their message.
        allow update: if isSignedIn()
          && resource.data.senderId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['deleted', 'text']);
      }
    }

    // ─── Notifications ──────────────────────────────────────────────
    match /notifications/{notificationId} {
      allow read: if isSignedIn()
        && resource.data.userId == request.auth.uid;
      allow write: if false; // backend-only
    }

    // ─── Reviews ────────────────────────────────────────────────────
    match /reviews/{reviewId} {
      allow read: if true; // public reputation
      allow create: if isSignedIn()
        && request.resource.data.reviewerId == request.auth.uid
        && request.resource.data.type in ['positive', 'negative'];
      allow update, delete: if false; // immutable once written
    }

    // ─── Trade records ──────────────────────────────────────────────
    // Written by respondToOffer and executeTrade, which use the
    // Admin SDK. There was no rule for this collection at all, so
    // Firestore's default deny applied: the records existed and
    // nobody could read them, not even the two parties to the
    // trade.
    match /trades/{tradeId} {
      allow read: if isSignedIn() && (
        resource.data.partyAId == request.auth.uid ||
        resource.data.partyBId == request.auth.uid
      );
      allow write: if false; // backend-only
    }

    // ─── Sync metadata (priceScraper bookkeeping) ─────────────────
    match /sync_meta/{document=**} {
      allow read, write: if false; // backend-only
    }

    // ─── Default deny-all ───────────────────────────────────────────
    // Any path not explicitly matched above is denied.
  }
}
